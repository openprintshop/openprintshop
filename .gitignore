# секреты и данные
.env
# ТОЛЬКО каталог данных бота в корне: правило `data/` без слэша совпадало с папкой `data`
# на ЛЮБОМ уровне, и `tests/data/` (фикстуры вроде step_box_with_hole.step) никогда не
# попадала в репозиторий — на чистом клоне тесты падали (поймано стендом 23.08.2026).
/data/

# окружение
__pycache__/
*.pyc
.venv/
venv/
# tools/ — личные утилиты разработчика, КРОМЕ инсталлятора: он — продукт (Track C),
# до 22.08.2026 лежал только на диске (правило `tools/` не давало git'у в него заглянуть).
tools/*
!tools/installer/
tools/installer/dist/
# ...и генератора лицензий (tools/licensing) — он тоже часть продукта (трек C, п.4).
# Строки ниже — ПРЕДОХРАНИТЕЛЬ: приватный ключ выпуска не должен иметь физической
# возможности попасть в индекс, даже если его случайно сохранят внутрь дерева.
!tools/licensing/
# ...и пульта приёмной на VPS (tools/edge: edge.ps1 + relayctl.py, 04.10.2026) — им выкладывают
# и переключают psb-relay, без них на чистом клоне не было бы ни выкладки, ни tests/relay.
!tools/edge/
# ...и выгрузки открытой версии (tools/opensource, 10.10.2026): без неё публичное дерево не собрать.
!tools/opensource/
tools/licensing/*.key
tools/licensing/*.pem
*private*.key
*.seed

# сборка настольной админки: Node нужен только разработчику,
# собранные app/webui/desk/desk.js* коммитятся — бот работает без Node
node_modules/
# собранные тесты фронта (npm run test:desk)
.desk-tests/
# sourcemap раздаётся вместе с бандлом — покупателю исходники не отдаём, пересобирается локально
app/webui/desk/desk.js.map

# кэши инструментов
.mypy_cache/
.pytest_cache/
.ruff_cache/

# оболочка ПК-админки: WebView2-профиль (localStorage с токеном). С 22.08.2026 профиль
# живёт в DATA_DIR/desk_profile (сам data/ игнорируется выше), но исторический каталог
# остаётся на диске до успешного переезда — и навсегда там, где переезд не прошёл.
desktop_admin/profile/

# временные/локальные артефакты
_run_*.log
_run_*.err
_build_*.py
*.output

# дизайн-хендоффы (референс, не исходники — держим вне репозитория)
design_handoff_*/
_design_bundle/

# выхлоп Bambu Studio CLI при запуске из корня (матрица слайсеров 21.08)
/00000.log
/result.json

# личные подопечные и задачи сторожа этой машины (см. watchdog._load_local)
/watchdog_local.py
